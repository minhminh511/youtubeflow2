# Keep DATABASE_URL from your deployment environment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Google Auth Platform > Clients > Web application.
# Never prefix these server-only values with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers > Your app > Settings > Basic. Used for Facebook Login and Pages.
# Never prefix these server-only values with NEXT_PUBLIC_.
# Add this exact redirect URI in Facebook Login settings: APP_URL + /api/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional: pin a Graph API version. Default v25.0.
META_GRAPH_VERSION=v25.0

# TikTok for Developers > your app > Login Kit + Content Posting API.
# Redirect URI must be APP_URL + /api/tiktok/callback
# Use the Client Key from the same tab (Production or Sandbox) as the redirect URI you registered.
# Paste with no quotes and no line breaks; an App ID is NOT a Client Key.
# If TIKTOK_CLIENT_KEY is empty/invalid, TubeFlow blocks the redirect instead of letting TikTok
# answer with its own "client_key" error page.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional. Default is user.info.basic only (guaranteed by Login Kit).
# Add publishing scopes only after they are granted to your app in TikTok for Developers.
# TIKTOK_SCOPES=user.info.basic,video.list,video.publish,video.upload

# Optional: register a Redirect URI on a domain you own, verified in TikTok > URL properties.
# Useful when the app is served through a tunnel but TikTok must see your verified domain.
# TIKTOK_REDIRECT_URI=https://tenmien-cua-ban.com/api/tiktok/callback

# Optional: contents of TikTok's signature file. When set, TubeFlow serves it at
# /tiktok-developers-site-verification.txt so TikTok can verify the domain by file.
# TIKTOK_SITE_VERIFICATION=

# Generate a random key, for example with: openssl rand -hex 32
# Minimum 32 characters. Keep stable after connecting a channel.
YOUTUBE_TOKEN_SECRET=

# Local development only. For deployment or Cloudflare Tunnel, use the current HTTPS origin.
# Example tunnel value: https://your-current-tunnel.trycloudflare.com
# No path, query string, fragment, or trailing slash.
# .env.local (and process-level variables) can override this value. Restart after editing.
APP_URL=http://localhost:3000

# This is a comment, NOT a setting that updates Google Cloud:
# Authorized redirect URI = APP_URL + /api/youtube/callback
# Paste that FULL URI into Google Auth Platform > Clients > Authorized redirect URIs.
# Never paste only the bare APP_URL there.
# If an encryption key is disclosed, rotate it privately and reconnect affected channels.

# Optional: contact details shown in the "Liên hệ" section of
# /chinh-sach-bao-mat and /dieu-khoan-su-dung. Leave blank to hide the email and use "TubeFlow".
# Example:
#   LEGAL_CONTACT_EMAIL=hotro@tenmien.vn
#   LEGAL_ENTITY_NAME=Công ty TNHH ABC
LEGAL_CONTACT_EMAIL=
LEGAL_ENTITY_NAME=
